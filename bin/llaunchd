#!/usr/bin/env lua

-- llaunchd CLI entry point

local function script_path()
  local info = debug.getinfo(1, "S")
  local path = info.source:match("^@(.+)$")
  if not path then return "." end
  local resolved = io.popen('readlink -f "' .. path .. '"'):read("*a")
  if resolved then
    resolved = resolved:gsub("\n+$", "")
    if resolved ~= "" then path = resolved end
  end
  return path:match("(.*/)") or "."
end

local self_dir = script_path()
local project_root = self_dir:match("(.*/)[^/]+/$") or self_dir
local llaunchd_dir = project_root .. "llaunchd/"

-- Add paths so require("service"), require("plist") etc. work directly
package.path = llaunchd_dir .. "?.lua;" ..
               llaunchd_dir .. "?/init.lua;" ..
               llaunchd_dir .. "backends/?.lua;" ..
               llaunchd_dir .. "commands/?.lua;" ..
               project_root .. "?.lua;" ..
               project_root .. "?/init.lua;" ..
               package.path

-- Define global defineAgent for service files
---@class AgentConfig
---@field Label string
---@field Program string
---@field RunAtLoad? boolean
---@field Restart? "always"|"on-failure"|"never"
---@field StdOut? string
---@field StdErr? string
---@field Env? table<string, string>
---@field KeepAlive? boolean|table
---@field WatchPaths? string[]
---@field WorkingDirectory? string
---@field ProcessType? "Standard"|"Background"|"Adaptive"
---@field Description? string
---@field Type? string
---@field WantedBy? string
---@field SoftResourceLimits? table
---@field HardResourceLimits? table
---@field TimeOut? number
---@field ExitTimeOut? number

---@param config AgentConfig
---@return AgentConfig
function defineAgent(config) return config end

-- Parse flags
local flags = {
  unsafe_relative = false,
  dry_run = false,
}
local clean_args = {}
for i = 1, #arg do
  if arg[i] == "--unsafe-relative-path" then
    flags.unsafe_relative = true
  elseif arg[i] == "--dry-run" or arg[i] == "-n" then
    flags.dry_run = true
  else
    clean_args[#clean_args + 1] = arg[i]
  end
end

-- Pass flags to service module
package.preload["llaunchd_flags"] = function()
  return flags
end

-- Parse command
local command = clean_args[1]
local cmd_arg = clean_args[2]

if not command or command == "help" or command == "--help" or command == "-h" then
  local ll = require("llaunchd")
  ll.usage()
  os.exit(0)
end

-- Check for backend override via env
if os.getenv("LLAUNCHD_BACKEND") then
  local ll = require("llaunchd")
  ll.service.init(os.getenv("LLAUNCHD_BACKEND"))
end

local ll = require("llaunchd")

local cmd = ll.commands[command]
if not cmd then
  io.stderr:write("Unknown command: " .. command .. "\n")
  io.stderr:write("Run 'llaunchd help' for usage.\n")
  os.exit(1)
end

local exit_code = cmd.run(cmd_arg)
os.exit(exit_code or 0)
